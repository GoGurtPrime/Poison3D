TARGET = out/dreamcast/bin/main.elf

include generated/dreamcast_sources.mk
OBJS = $(GEN_DC_SOURCES:.c=.o)

KOS_ROMDISK_DIR = romdisk

all: rm-elf $(TARGET)

include $(KOS_BASE)/Makefile.rules

clean: rm-elf
	-rm -f $(OBJS)

rm-elf:
	-rm -f $(TARGET) romdisk.*

$(TARGET): $(OBJS)
	mkdir -p $(@D)
	kos-cc -o $(TARGET) $(OBJS) -lGL -lpcx -lkosutils -lkosfat

run: $(TARGET)
	$(KOS_LOADER) $(TARGET)

dist: $(TARGET)
	-rm -f $(OBJS) romdisk.img
	$(KOS_STRIP) $(TARGET)