V=1
SOURCE_DIR=src
BUILD_DIR=out/n64
include $(N64_INST)/include/n64.mk

CPPFLAGS += -DPLATFORM_N64=1

all: hello.z64
.PHONY: all

include generated/n64_sources.mk

OBJS = $(patsubst %.c,$(BUILD_DIR)/%.o,$(GEN_N64_SOURCES))

hello.z64: N64_ROM_TITLE="Hello World"
hello.z64: $(BUILD_DIR)/hello.dfs

$(BUILD_DIR)/hello.dfs: src/apps/sandbox/assets/
$(BUILD_DIR)/hello.dfs: $(shell find src/apps/sandbox/assets -type f)

$(BUILD_DIR)/hello.elf: $(OBJS)

clean:
	rm -f $(BUILD_DIR)/* *.z64
.PHONY: clean

-include $(wildcard $(BUILD_DIR)/*.d)