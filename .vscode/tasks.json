{
  "version": "2.0.0",
  "tasks": [
    {
      // Windows build (native, via CMake preset)
      "label": "build:windows",
      "type": "shell",
      "command": "cmake --build --preset windows-vcpkg",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      // N64 build (requires libdragon CLI and Docker Desktop).
      // CMake regenerates generated/n64_sources.mk from CMakeLists.txt,
      // then delegates the actual ROM build to libdragon's make.
      "label": "build:n64",
      "type": "shell",
      "command": "cmake --preset n64 && cmake --build --preset n64",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      // Dreamcast build using WSL (requires KOS toolchain).
      // CMake regenerates generated/dreamcast_sources.mk from CMakeLists.txt,
      // then delegates the actual build to KOS's make (via WSL).
      "label": "build:dreamcast",
      "type": "shell",
      "command": "cmake --preset dreamcast && cmake --build --preset dreamcast",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      // Send build to Dreamcast over BBA using WSL (requires dcload-ip/dc-tool-ip)
      "label": "build:dreamcast-load-ip",
      "type": "process",
      "command": "wsl.exe",
      "args": [
          "bash",
          "-lc",
          ". /opt/toolchains/dc/kos/environ.sh && /opt/toolchains/dc/bin/dc-tool-ip -x main.elf -t ${input:ipAddress}"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      // Package Dreamcast build into a burnable CDI using WSL (required KOS toolchain)
      "label": "build:dreamcast-cdi",
      "type": "process",
      "command": "wsl.exe",
      "args": [
          "bash",
          "-lc",
          ". /opt/toolchains/dc/kos/environ.sh && /opt/toolchains/mkdcdisc/builddir/mkdcdisc -n poison3d -a colin -D src/apps/sandbox/assets -e ./out/dreamcast/bin/main.elf -o ./out/dreamcast/bin/main.cdi"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    }
  ],
  "inputs": [
    {
        "id": "ipAddress",
        "type": "promptString",
        "description": "What is the IP Address of your Dreamcast?",
        "default": "0.0.0.0"
    }
  ]
}
