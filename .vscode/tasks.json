{
  "version": "2.0.0",
  "tasks": [
    {
      // N64 build (requires libdragon CLI and Docker Desktop)
      "label": "build:n64",
      "type": "shell",
      "command": "libdragon make -f N64Makefile",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      // Dreamcast build using WSL (requires KOS toolchain)
      "label": "build:dreamcast",
      "type": "process",
      "command": "wsl.exe",
      "args": [
          "bash",
          "-lc",
          ". /opt/toolchains/dc/kos/environ.sh && make clean -f KosMakefile && make -f KosMakefile"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      // Send build to Dreamcast over BBA using WSL (requires dcload-ip/dc-tool-ip)
      "label": "build:dreamcast-load-ip",
      "type": "process",
      "command": "wsl.exe",
      "args": [
          "bash",
          "-lc",
          ". /opt/toolchains/dc/kos/environ.sh && /opt/toolchains/dc/bin/dc-tool-ip -x main.elf -t ${input:ipAddress}"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      // Package Dreamcast build into a burnable CDI using WSL (required KOS toolchain)
      "label": "build:dreamcast-cdi",
      "type": "process",
      "command": "wsl.exe",
      "args": [
          "bash",
          "-lc",
          ". /opt/toolchains/dc/kos/environ.sh && /opt/toolchains/mkdcdisc/builddir/mkdcdisc -e ./main.elf -o ./main.cdi"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    }
  ],
  "inputs": [
    {
        "id": "ipAddress",
        "type": "promptString",
        "description": "What is the IP Address of your Dreamcast?",
        "default": "0.0.0.0"
    }
  ]
}
